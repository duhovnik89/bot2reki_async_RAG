# Скопируй этот файл в .env и заполни своими данными
# Сам файл .env в GitHub не выкладывается (он в .gitignore)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# --- ВКонтакте (токен сообщества, не личной страницы) ---
VK_TOKEN=your_vk_community_token_here

# --- OpenRouter: LLM и эмбеддинги RAG ходят в один эндпоинт ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM_MODEL=google/gemini-3.1-flash-lite
# EMBED_MODEL=intfloat/multilingual-e5-large

# --- История переписки (пусто — в памяти процесса) ---
HISTORY_S3_BUCKET=

# --- Файлы с правилами ---
# Excel-архив (вход для bot/sync.py) и подготовленный rules.json (индексируется ботом)
RULES_FILE_PATH=data/rules.xlsx
RULES_JSON_PATH=data/rules.json

# --- Архив в Object Storage (пусто — локальный файл rules.json) ---
RULES_S3_BUCKET=
RULES_S3_KEY=rules.json

# --- RAG (значения по умолчанию) ---
# Сколько фрагментов доставать на вопрос
RAG_TOP_K=12

# --- Контакт администратора ---
ADMIN_CONTACT=@duhovnik_89
