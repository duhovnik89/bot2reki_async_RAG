%% architecture v6 — 2026-11-24
%% Изменения: эмбеддинги переведены с локальной HuggingFace-модели (PyTorch)
%% на OpenRouter API (/v1/embeddings, OpenAI-совместимый); добавлен дисковый
%% кэш векторов rules.embeddings.npz — повторные старты собирают индекс без
%% вызовов API. Пакет снова лёгкий, деплой в Cloud Functions возможен.
flowchart TD

    TG_USER["Житель в Telegram"]
    VK_USER["Житель во ВКонтакте"]

    GW["API Gateway\n/ (Telegram webhook) · /vk-callback"]

    subgraph FN_SG ["Процесс бота (main.py) · serverless-обёртка"]
        SYNC_PATH["Быстрая ветка (секунды)\n/start · старт → приветствие, кнопки, очистка истории\n«Ищу ответ…» → задание в async-вызов"]
        WORKER["Async-воркер (само-вызов, HMAC-подпись)\nprocess_tg_job · process_vk_job"]
        INDEX["VectorStoreIndex в памяти (LlamaIndex)\n290 фрагментов; векторы — из дискового кэша"]
        EMB["OpenRouter API\n/v1/embeddings · multilingual-e5-large\nэмбеддятся только недостающие фрагменты"]
        ENGINE["RulesEngine (bot/search.py)\nвопрос + последние реплики → векторный поиск\ntop-12 фрагментов → правила + фрагменты + вопрос"]
        HIST["bot/history.py\nпоследние 10 сообщений за 60 мин\nпо 1000 символов"]
        DBSRC["bot/source.py\nrules.json → /tmp, ETag-проверка раз в 5 мин"]
    end

    subgraph S3_SG ["Object Storage"]
        RULES_BUCKET[("Бакет архива решений\nrules.json\nзалил файл — бот подхватил")]
        HIST_BUCKET[("Бакет истории\nhistory/tg|vk/чат/житель.json\nавтоудаление через 7 дней")]
    end

    DS["OpenRouter API\nLLM: google/gemini-3.1-flash-lite\ntemperature 0.1 · max_tokens 1024\nво входе — только найденные фрагменты"]

    SYNC_BOX["bot/sync.py (локально)\nrules.xlsx → rules.json\nзагрузка в бакет вручную"]

    CACHE[("data/rules.embeddings.npz\nвекторы по хэшу текста фрагмента\nсмена модели — кэш сбрасывается")]

    OK["Ответ жителю"]
    NOADM["«Информации не нашлось.\nОбратитесь к администратору: @duhovnik_89»"]

    TG_USER --> GW
    VK_USER --> GW
    GW --> SYNC_PATH
    SYNC_PATH -->|"?integration=async"| WORKER
    SYNC_PATH -->|"/start: удалить историю"| HIST

    WORKER -->|"1. прочитать историю"| HIST
    WORKER -->|"2. вопрос + история"| ENGINE
    ENGINE -->|"поиск"| INDEX
    INDEX <-->|"векторы знакомых фрагментов"| CACHE
    INDEX -.->|"новые/изменённые фрагменты"| EMB
    ENGINE --> DS
    DS -->|"ответ"| OK
    DS -->|"[НУЖЕН_АДМИНИСТРАТОР]"| NOADM
    WORKER -->|"3. дописать вопрос и ответ\n(только удачные)"| HIST

    HIST <-->|"GET / PUT / DELETE\nотказ → ответ без истории + ERROR в логе"| HIST_BUCKET
    DBSRC -->|"GET с If-None-Match"| RULES_BUCKET
    DBSRC -->|"rules.json"| INDEX
    SYNC_BOX --> RULES_BUCKET
